<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ChatPlus</AssemblyName>
    <Product>ChatPlus</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <RestoreSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
    </RestoreSources>
    <BepInExPluginGuid>io.vrising.ChatPlus</BepInExPluginGuid>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <VRisingClientPath>T:\SteamLibrary\steamapps\common\VRising</VRisingClientPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.733" IncludeAssets="compile" />
    <PackageReference Include="VRising.Unhollowed.Client" Version="1.1.8.9179701" />
  </ItemGroup>

  <Target Name="DeployToClient" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)$(ProjectName).dll" DestinationFolder="$(VRisingClientPath)\BepInEx\plugins" />
  </Target>
</Project>
